# ── Slack ──────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...          # only needed for Socket Mode
SLACK_SIGNING_SECRET=...          # only needed for HTTP mode

# ── Grok (x.ai) ──────────────────────────────────
XAI_API_KEY=xai-...
# GROK_MODEL=grok-4.3-latest

# ── Google Drive ──────────────────────────────────
# Master case study folder (defaults to the Creative Strategy folder).
DRIVE_ROOT_FOLDER_ID=15I3CdBcBvQ9kUO_b7-mpausV3VzgWjQO

# Option A (recommended): service account. Share the Drive folder with the
# service account's email (Viewer). Provide the key JSON ONE of these ways:
GOOGLE_SERVICE_ACCOUNT_JSON_B64=   # base64 of the key file (best for Render)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B: OAuth user credentials (a human account that can see the folder).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# How long to cache the folder listing before re-reading Drive (minutes).
DRIVE_CACHE_TTL_MIN=10
# Max characters of deck text sent to Grok per shortlisted case study.
DRIVE_MAX_CONTENT_CHARS=4000

# ── Mode ──────────────────────────────────────────
SLACK_SOCKET_MODE=true            # set "false" for HTTP mode on Render

# ── HTTP port (only used when SLACK_SOCKET_MODE=false)
PORT=3000
