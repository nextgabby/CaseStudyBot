# ── Slack ──────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...          # Vercel (HTTP) — verifies requests from Slack
SLACK_APP_TOKEN=xapp-...          # local dev only (Socket Mode, `npm run dev`)

# ── Grok (x.ai) ──────────────────────────────────
XAI_API_KEY=xai-...
# GROK_MODEL=grok-4.3-latest

# ── Google Drive ──────────────────────────────────
# Master case study folder (defaults to the Creative Strategy folder).
DRIVE_ROOT_FOLDER_ID=15I3CdBcBvQ9kUO_b7-mpausV3VzgWjQO

# Option A (production on Vercel, keyless): Workload Identity Federation.
# Vercel's OIDC token is exchanged for a short-lived token impersonating the
# service account. Share the Drive folder with the SA email as Viewer.
GCP_WORKLOAD_IDENTITY_AUDIENCE=//iam.googleapis.com/projects/<PROJECT_NUMBER>/locations/global/workloadIdentityPools/vercel/providers/vercel
GCP_SERVICE_ACCOUNT_EMAIL=casestudybot@xai-dev-casestudybot.iam.gserviceaccount.com

# Option B (local dev): your own Google login via Application Default Credentials.
#   gcloud auth application-default login --scopes=https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/cloud-platform
# then set none of the Google vars above.

# Option C (only if a key exemption is granted): service account key JSON.
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option D: OAuth user credentials.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# How long a warm instance caches the folder listing before re-reading Drive (minutes).
DRIVE_CACHE_TTL_MIN=10
# Max characters of deck text sent to Grok per shortlisted case study.
DRIVE_MAX_CONTENT_CHARS=4000
